+bool cu_configurator_impl::get_amf_ue_id_and_guami(const ue_index_t& ue_index,
+                                                    amf_ue_id_t&      amf_ue_id,
+                                                    guami_t&          guami) const
+{
+  for (auto& kv : ngap_db.get_ngaps()) {
+    ngap_interface* ngap = kv.second;
+    if (ngap == nullptr) {
+      continue;
+    }
+    amf_ue_id_t id = ngap->get_ngap_ue_id_translator().get_amf_ue_id(ue_index);
+    if (id != amf_ue_id_t::invalid) {
+      amf_ue_id = id;
+      guami     = ngap->get_ngap_ue_id_translator().get_guami(ue_index);
+      return true;
+    }
+  }
+  return false;
+}
