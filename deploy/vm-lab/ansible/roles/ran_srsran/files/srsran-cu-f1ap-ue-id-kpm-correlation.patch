+// Fills ueid with a real amf_ue_ngap_id (+ GUAMI), sourced from NGAP via cu_cfg -- confirmed on a real run that
+// upstream's own get_ues_matching_test_conditions() (`return true` with `ues` left untouched) is why
+// amf_ue_ngap_id never reached E2SM-KPM at all: the CU-CP provider had no CU-CP/NGAP reference to read it from,
+// same root cause as the CU-CP variant registering zero metrics in the first place.
+static bool
+append_gnb_ue_id(cu_configurator* cu_cfg, srs_cu_cp::ue_index_t ue_index, std::vector<asn1::e2sm::ue_id_c>& ues)
+{
+  srs_cu_cp::amf_ue_id_t amf_ue_id;
+  srs_cu_cp::guami_t     guami;
+  if (!cu_cfg->get_amf_ue_id_and_guami(ue_index, amf_ue_id, guami)) {
+    return false;
+  }
+  asn1::e2sm::ue_id_c     ueid;
+  asn1::e2sm::ue_id_gnb_s ueid_gnb{};
+  ueid_gnb.amf_ue_ngap_id = srs_cu_cp::amf_ue_id_to_uint(amf_ue_id);
+  ueid_gnb.guami.plmn_id = guami.plmn.to_bytes();
+  ueid_gnb.guami.amf_region_id.from_number(guami.amf_region_id);
+  ueid_gnb.guami.amf_set_id.from_number(guami.amf_set_id);
+  ueid_gnb.guami.amf_pointer.from_number(guami.amf_pointer);
+  // Also carry the SAME gnb_cu_ue_f1ap_id the DU's own KPM provider already exposes (see
+  // e2sm_kpm_du_meas_provider_impl.cpp's own get_ues_matching_test_conditions()) -- lets an xApp correlate a
+  // CU-CP indication (amf_ue_ngap_id) with a DU indication (gnb_cu_ue_f1ap) for the same physical UE, without
+  // needing to touch CU-UP's own separate UE-index space at all (see docs/ran-testing.md's own note on why
+  // extending this to CU-UP specifically needs an E1AP-based bridge instead -- this F1AP one didn't).
+  gnb_cu_ue_f1ap_id_t f1ap_id = cu_cfg->get_f1ap_ue_id_for_kpm(ue_index);
+  if (f1ap_id != gnb_cu_ue_f1ap_id_t::invalid) {
+    asn1::e2sm::ue_id_gnb_cu_cp_f1ap_id_item_s f1ap_item{};
+    f1ap_item.gnb_cu_ue_f1ap_id = gnb_cu_ue_f1ap_id_to_uint(f1ap_id);
+    ueid_gnb.gnb_cu_ue_f1ap_id_list.push_back(f1ap_item);
+  }
+  ueid.set_gnb_ue_id() = ueid_gnb;
+  ues.push_back(ueid);
+  return true;
+}
