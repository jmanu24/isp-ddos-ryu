+
+gnb_cu_ue_f1ap_id_t cu_configurator_impl::get_f1ap_ue_id_for_kpm(const ue_index_t& ue_index) const
+{
+  cu_cp_ue* ue = ue_mng.find_du_ue(ue_index);
+  if (ue == nullptr) {
+    return gnb_cu_ue_f1ap_id_t::invalid;
+  }
+  du_index_t du_index = ue->get_du_index();
+  if (du_index == du_index_t::invalid or du_db.find_du_processor(du_index) == nullptr) {
+    return gnb_cu_ue_f1ap_id_t::invalid;
+  }
+  return du_db.get_du_processor(du_index).get_f1ap_handler().get_f1ap_ue_id_for_kpm(ue_index);
+}
