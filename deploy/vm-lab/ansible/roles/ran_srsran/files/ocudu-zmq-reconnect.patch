+void radio_zmq_tx_channel::rebind()
+{
+  logger.warning("Request/response cycle stalled. Recreating transmitter socket ({}).", address);
+
+  if (sock != nullptr) {
+    ::zmq_close(sock);
+    sock = nullptr;
+  }
+
+  sock = ::zmq_socket(zmq_context, socket_type);
+  if (sock == nullptr) {
+    logger.error("Failed to recreate transmitter socket ({}). {}.", address, ::zmq_strerror(::zmq_errno()));
+    state_fsm.on_error();
+    return;
+  }
+
+  bool     bind_success     = false;
+  unsigned bind_trial_count = 0;
+  while (!bind_success && bind_trial_count != REBIND_MAX_TRIALS) {
+    if (bind_trial_count != 0) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(REBIND_FAILURE_SLEEP_MS));
+    }
+
+    bind_success = (::zmq_bind(sock, address.c_str()) == 0);
+    if (!bind_success) {
+      if (::zmq_errno() != EADDRINUSE) {
+        break;
+      }
+      bind_trial_count++;
+    }
+  }
+
+  if (!bind_success) {
+    logger.error("Failed to rebind transmitter socket ({}). {}.", address, ::zmq_strerror(::zmq_errno()));
+    state_fsm.on_error();
+    return;
+  }
+
+  if (trx_timeout_ms) {
+    int timeout = trx_timeout_ms;
+
+    if (::zmq_setsockopt(sock, ZMQ_RCVTIMEO, &timeout, sizeof(timeout)) == -1) {
+      logger.error("Failed to set receive timeout on tx socket. {}.", ::zmq_strerror(::zmq_errno()));
+      state_fsm.on_error();
+      return;
+    }
+
+    if (::zmq_setsockopt(sock, ZMQ_SNDTIMEO, &timeout, sizeof(timeout)) == -1) {
+      logger.error("Failed to set send timeout on tx socket. {}.", ::zmq_strerror(::zmq_errno()));
+      state_fsm.on_error();
+      return;
+    }
+
+    timeout = linger_timeout_ms;
+    if (::zmq_setsockopt(sock, ZMQ_LINGER, &timeout, sizeof(timeout)) == -1) {
+      logger.error("Failed to set linger timeout on tx socket. {}.", ::zmq_strerror(::zmq_errno()));
+      state_fsm.on_error();
+      return;
+    }
+  }
+
+  logger.info("Transmitter socket rebound ({}).", address);
+}
