+void radio_zmq_rx_channel::reconnect()
+{
+  if (sock != nullptr) {
+    zmq_close(sock);
+    sock = nullptr;
+  }
+
+  sock = zmq_socket(zmq_context, socket_type);
+  if (sock == nullptr) {
+    logger.error("Failed to reopen receiver socket ({}). {}.", address, zmq_strerror(zmq_errno()));
+    state_fsm.on_error();
+    return;
+  }
+
+  if (zmq_connect(sock, address.c_str()) == -1) {
+    logger.error("Failed to reconnect receiver socket ({}). {}.", address, zmq_strerror(zmq_errno()));
+    state_fsm.on_error();
+    return;
+  }
+
+  if (trx_timeout_ms) {
+    int timeout = trx_timeout_ms;
+    if (zmq_setsockopt(sock, ZMQ_RCVTIMEO, &timeout, sizeof(timeout)) == -1 ||
+        zmq_setsockopt(sock, ZMQ_SNDTIMEO, &timeout, sizeof(timeout)) == -1) {
+      logger.error("Failed to set timeout on reconnected socket. {}.", zmq_strerror(zmq_errno()));
+      state_fsm.on_error();
+      return;
+    }
+    timeout = linger_timeout_ms;
+    if (zmq_setsockopt(sock, ZMQ_LINGER, &timeout, sizeof(timeout)) == -1) {
+      logger.error("Failed to set linger on reconnected socket. {}.", zmq_strerror(zmq_errno()));
+      state_fsm.on_error();
+      return;
+    }
+  }
+
+  logger.info("Receiver socket reconnected ({}).", address);
+}
