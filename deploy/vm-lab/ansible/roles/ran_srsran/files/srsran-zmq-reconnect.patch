+void radio_zmq_tx_channel::rebind()
+{
+  if (sock != nullptr) {
+    zmq_close(sock);
+    sock = nullptr;
+  }
+
+  sock = zmq_socket(zmq_context, socket_type);
+  if (sock == nullptr) {
+    logger.error("Failed to reopen transmitter socket ({}). {}.", address, zmq_strerror(zmq_errno()));
+    state_fsm.on_error();
+    return;
+  }
+
+  bool     bind_success     = false;
+  unsigned bind_trial_count = 0;
+  while (!bind_success && bind_trial_count != BIND_MAX_TRIALS) {
+    if (bind_trial_count != 0) {
+      zmq_sleep(BIND_FAILURE_SLEEP_SECONDS);
+    }
+    bind_success = (zmq_bind(sock, address.c_str()) == 0);
+    if (!bind_success) {
+      if (zmq_errno() != EADDRINUSE) {
+        break;
+      }
+      bind_trial_count++;
+    }
+  }
+
+  if (!bind_success) {
+    logger.error("Failed to rebind transmitter socket ({}). {}.", address, zmq_strerror(zmq_errno()));
+    state_fsm.on_error();
+    return;
+  }
+
+  if (trx_timeout_ms) {
+    int timeout = trx_timeout_ms;
+    if (zmq_setsockopt(sock, ZMQ_RCVTIMEO, &timeout, sizeof(timeout)) == -1 ||
+        zmq_setsockopt(sock, ZMQ_SNDTIMEO, &timeout, sizeof(timeout)) == -1) {
+      logger.error("Failed to set timeout on rebound socket. {}.", zmq_strerror(zmq_errno()));
+      state_fsm.on_error();
+      return;
+    }
+    timeout = linger_timeout_ms;
+    if (zmq_setsockopt(sock, ZMQ_LINGER, &timeout, sizeof(timeout)) == -1) {
+      logger.error("Failed to set linger on rebound socket. {}.", zmq_strerror(zmq_errno()));
+      state_fsm.on_error();
+      return;
+    }
+  }
+
+  logger.info("Transmitter socket rebound ({}).", address);
+}
