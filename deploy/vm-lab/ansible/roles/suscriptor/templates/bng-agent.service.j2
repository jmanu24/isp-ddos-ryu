# Managed by Ansible (roles/suscriptor). Persistent BNGBlaster control
# daemon for the Broadband domain's distributed-mode pipeline -- see
# simulation/bng_agent.py's own module docstring. Runs as root (no User=
# override) -- BNGBlaster itself needs raw-socket access (cap_net_raw/
# cap_net_admin), same as every other real-packet-generating process in
# this lab (hping3 on peer-router/ent-site-*).
[Unit]
Description=bng-agent -- BNGBlaster control daemon (Broadband domain, distributed mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Tesis_Controller
Environment=PYTHONPATH=/opt/Tesis_Controller
# bng_access_iface/bng_network_iface, NOT suscriptor_mgmt_iface -- those
# are BNGBlaster's own dedicated, address-less interfaces (see the
# suscriptor role's own tasks for why it can't share the MGMT NIC that
# provides THIS host's SSH/orchestrator reachability). bng_network_addr
# is BNGBlaster's own internal address for its "network" side,
# deliberately distinct from suscriptor_mgmt_addr (a different NIC's
# real kernel IP on the same VLAN-MGMT segment) to avoid an ARP conflict.
ExecStart=/usr/bin/python3 simulation/bng_agent.py \
    --target-ip {{ bng_target_ip }} \
    --access-interface {{ bng_access_iface }} \
    --network-interface {{ bng_network_iface }} \
    --network-ip {{ bng_network_addr }}/24 \
    --network-gateway {{ mgmt_control_node_ip }} \
    --fifo /run/bng-agent/cmd
Restart=on-failure
RestartSec=2
StandardOutput=append:/var/log/bng-agent.log
StandardError=append:/var/log/bng-agent.log

[Install]
WantedBy=multi-user.target
