# Managed by Ansible (roles/suscriptor). One real, distinct PAP
# identity per simulated subscriber (macvlan1..N) -- pppd's own `user`
# option looks up its own client/secret pair here by name. Not
# security-sensitive (throwaway local-simulation lab, same posture as
# FreeRADIUS's own accept-all `DEFAULT Auth-Type := Accept` on `bng` --
# these credentials are never actually checked against anything real).
#
# client        server  secret          IP addresses
{% for n in range(1, bng_subscriber_count + 1) %}
"sub{{ n }}"       *       "sub{{ n }}pass"       *
{% endfor %}
