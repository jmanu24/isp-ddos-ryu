#!/bin/sh
set -eu
PARENT="{{ suscriptor_access_iface }}"
ip link set "$PARENT" up
for n in $(seq 1 {{ bng_subscriber_count }}); do
  ns="fixed$n"
  iface="macvlan$n"
  if ! ip netns list | awk '{print $1}' | grep -qx "$ns"; then
    ip netns add "$ns"
  fi
  if ! ip -n "$ns" link show dev "$iface" >/dev/null 2>&1; then
    if ! ip link show dev "$iface" >/dev/null 2>&1; then
      hex=$(printf '%02x' "$n")
      ip link add link "$PARENT" name "$iface" address "02:00:00:00:00:$hex" type macvlan mode bridge
    fi
    ip link set "$iface" netns "$ns"
  fi
  ip -n "$ns" link set lo up
  ip -n "$ns" link set "$iface" up
  mkdir -p "/etc/netns/$ns"
  if [ ! -f "/etc/netns/$ns/resolv.conf" ]; then
    printf '# DNS local to %s; populated by DHCP\n' "$ns" > "/etc/netns/$ns/resolv.conf"
  fi
done
