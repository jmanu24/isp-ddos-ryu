# Managed by Ansible (roles/bng). Counts what each subscriber MAC sends into
# the access NIC, per protocol, whether or not it has an accel-ppp session:
# telemetry/broadband_adapter.py reads these to decide when a blocked
# subscriber has really stopped (Broadband release hysteresis). Counters
# only -- nothing is dropped or modified here.
add table netdev {{ bng_offered_nft_table }}
delete table netdev {{ bng_offered_nft_table }}
table netdev {{ bng_offered_nft_table }} {
	chain {{ bng_offered_nft_chain }} {
		type filter hook ingress device "{{ bng_access_iface }}" priority -300; policy accept;
{% for n in range(1, bng_subscriber_count + 1) %}
{% set mac = '02:00:00:00:00:%02x' % n %}
		ether saddr {{ mac }} ip protocol udp counter comment "{{ mac }} udp"
		ether saddr {{ mac }} ip protocol icmp counter comment "{{ mac }} icmp"
		ether saddr {{ mac }} ip protocol tcp tcp flags & (syn | ack) == syn counter comment "{{ mac }} tcp_syn"
{% endfor %}
	}
}
