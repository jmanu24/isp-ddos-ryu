#!/bin/sh
# Managed by Ansible (roles/bng). Called by FreeRADIUS's mac_blocked exec
# module from authorize{}: prints 1 if a reject marker exists for the given
# MAC (Calling-Station-Id), else 0. telemetry/broadband_adapter.py creates
# the marker on block and removes it on unblock.
#
# The argument comes from the network, so it is accepted only if it is
# exactly a MAC address -- anything else is "not blocked" and never reaches
# the filesystem lookup.
DIR={{ bng_radius_blocked_dir }}

mac=$(printf '%s' "$1" | tr 'A-F' 'a-f')
case "$mac" in
  [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) ;;
  *) echo 0; exit 0 ;;
esac

if [ -e "$DIR/$mac" ]; then echo 1; else echo 0; fi
