# Managed by Ansible (roles/bng). accel-ppp as an IPoE access
# concentrator -- subscriber "sessions" are just DHCPv4 clients on
# {{ bng_access_iface }} (see roles/suscriptor's macvlan-per-subscriber
# setup), each authenticated+accounted via FreeRADIUS on 127.0.0.1
# (this role's own tasks configure that side).
#
# NOT yet verified against a real run -- directive names/syntax below
# are accel-ppp's own documented config format (see its repo's
# accel-pppd/*.conf* examples / configuration.rst under
# /opt/accel-ppp-src after deploy/install_accelppp.sh runs), cross-
# check there if accel-pppd fails to start or logs a config error.

[modules]
log_syslog
log_file
ipoe
ippool
radius

[core]
thread-count=1

[common]
single-session=replace

[ipoe]
# No username=calling-sid -- confirmed on a real run: accel-ppp's ipoe
# module only recognizes username=ifname or username=lua:<func> (any
# other value logs "ipoe: unknown username value" to emerg.log and
# falls back to its own default, the subscriber's not-yet-assigned IP
# as a string). Not load-bearing for this project either way -- the
# real MAC still reaches FreeRADIUS as the standard Calling-Station-Id
# attribute regardless of what User-Name ends up being, and that's what
# telemetry/broadband_adapter.py's distributed-mode collect() keys its
# src_ip->MAC mapping on, not User-Name. Simply omitted here.
#
# Kernel driver (deploy/install_accelppp.sh builds+loads ipoe.ko) IS
# required even without ifcfg=1 -- confirmed on a real run: accel-ppp's
# ipoe module talks to it over netlink for every incoming session
# regardless of ifcfg, failing immediately ("ipoe: not a IPoE message
# 2" / "ipoe: failed to create interface") without it loaded.
#
# ifcfg=1 back on now that the driver actually loads -- this project's
# real point (real per-session BYTE accounting) needs it: RADIUS
# Acct-Input/Output-Octets come from ap_session_read_stats() reading
# plain kernel netdev rx/tx counters on the session's own ipoeN
# interface (accel-pppd/session.c), which only increase if the ipoe.ko
# rx_handler on the parent actually redirects matching frames there
# (ipoe_recv()/ipoe_lookup_rt4() in drivers/ipoe/ipoe.c, matched by the
# session's source IP) -- confirmed that lookup depends on the
# session's IP being registered with the kernel driver, which is what
# ifcfg does (dont_ifcfg=1 otherwise). Without it, sessions established
# fine and DHCP/control chatter was counted (Output-Octets nonzero) but
# real subscriber DATA traffic (a real hping3 flood) never touched
# Input-Octets at all.
interface={{ bng_access_iface }},start=dhcpv4,ifcfg=1
noauth=0
ip-pool=bng_pool
# A SEPARATE gw-ip-address directive from [ip-pool]'s own one below --
# confirmed on a real run: the ipoe module's DHCP-offer/router-address
# logic (find_gw_addr(), accel-pppd/ctrl/ipoe/ipoe.c) reads its own
# gw-ip-address option straight out of THIS section, not [ip-pool]'s.
# Without it here, every session got as far as a real leased IP and
# then failed with "can't determine router address".
gw-ip-address={{ bng_access_addr }}/24
verbose=1

[ip-pool]
gw-ip-address={{ bng_access_addr }}/24
{{ bng_pool_range }},name=bng_pool

[dns]
dns1=8.8.8.8

[radius]
dictionary=/usr/share/accel-ppp/radius/dictionary
nas-identifier=bng
nas-ip-address={{ bng_access_addr }}
gw-ip-address={{ bng_access_addr }}
verbose=1
timeout=3
max-try=3
acct-timeout=3
# Short interim interval -- this IS the real telemetry signal telemetry/
# broadband_adapter.py's distributed-mode collect() tails (FreeRADIUS's
# detail log gets one Interim-Update record per session every N
# seconds, each carrying real Acct-Input/Output-Octets/-Packets).
acct-interim-interval=5

server=127.0.0.1,{{ bng_radius_secret }},auth-port=1812,acct-port=1813,req-limit=0

[cli]
tcp=127.0.0.1:2000
verbose=1

[log]
log-file=/var/log/accel-ppp/accel-ppp.log
log-emerg=/var/log/accel-ppp/emerg.log
copy=1
level=5
