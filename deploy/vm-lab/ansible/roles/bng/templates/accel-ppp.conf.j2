# Managed by Ansible (roles/bng). accel-ppp as a PPPoE access
# concentrator -- subscriber "sessions" are real PPPoE sessions
# terminated on {{ bng_access_iface }} (see roles/suscriptor's
# macvlan-per-subscriber + pppd setup), each authenticated+accounted
# via FreeRADIUS on 127.0.0.1 (this role's own tasks configure that
# side).
#
# REPLACES an earlier IPoE-mode design: confirmed on a real run that
# IPoE sessions authenticated, got real DHCP-assigned IPs, and appeared
# in accel-cmd show sessions correctly, but the kernel ipoe.ko driver's
# rx_handler never actually redirected real subscriber DATA traffic to
# the session's own ipoeN interface (RX bytes/packets stayed at exactly
# 0 on that netdev even under a real, massive hping3 flood, confirmed
# via `ip -s link show ipoeN`) -- so Acct-Input-Octets never moved off
# zero no matter how much real traffic flowed. PPPoE sidesteps this
# entirely: each session's traffic is actively encapsulated/
# decapsulated by the kernel's own generic PPP discipline as it passes
# through the session's real pppN interface, so that interface's plain
# netdev rx/tx counters (which is all ap_session_read_stats() in
# accel-pppd/session.c ever reads, regardless of access mode) are
# genuinely populated by the traffic itself, not by a separate
# classifier that has to actively choose to redirect frames there.
#
# NOT yet verified against a real run -- directive names/syntax below
# are accel-ppp's own documented config format (see its repo's
# accel-pppd/*.conf* examples / configuration.rst under
# /opt/accel-ppp-src after deploy/install_accelppp.sh runs), cross-
# check there if accel-pppd fails to start or logs a config error.

[modules]
log_syslog
log_file
pppoe
auth_pap
ippool
radius

[core]
thread-count=1

[common]
# NOT single-session=replace -- confirmed on a real run (IPoE mode,
# same underlying session.c code path) this compares sessions by
# User-Name and forcibly terminates whichever existing session already
# holds that name. PPPoE gives each subscriber a genuinely distinct
# User-Name (its own pap-secrets identity, unlike IPoE's shared
# interface-name fallback), so this bug class doesn't reappear here,
# but the directive itself is still meant for "the same subscriber
# genuinely reconnecting" -- not this project's situation (every
# macvlan+pppd pair is a distinct simulated subscriber) -- so it stays
# omitted.

[pppoe]
interface={{ bng_access_iface }}
ac-name=bng
verbose=1

[ppp]
verbose=1
mppe=deny
ipv4=require
ipv6=deny
lcp-echo-interval=30
lcp-echo-failure=3

[ip-pool]
# Unnamed/default pool -- no ip-pool= directive exists in [pppoe]/[ppp]
# the way IPoE mode had one in [ipoe] (unlike IPoE, PPP session setup
# doesn't take a pool name directly; the unnamed default pool created
# here is used automatically). Same range dnsmasq/the old IPoE config
# used to hand out.
gw-ip-address={{ bng_access_addr }}/24
{{ bng_pool_range }}

[dns]
dns1=8.8.8.8

[radius]
dictionary=/usr/share/accel-ppp/radius/dictionary
nas-identifier=bng
nas-ip-address={{ bng_access_addr }}
gw-ip-address={{ bng_access_addr }}
verbose=1
timeout=3
max-try=3
acct-timeout=3
# Short interim interval -- this IS the real telemetry signal telemetry/
# broadband_adapter.py's distributed-mode collect() tails (FreeRADIUS's
# detail log gets one Interim-Update record per session every N
# seconds, each carrying real Acct-Input/Output-Octets/-Packets).
acct-interim-interval=5

server=127.0.0.1,{{ bng_radius_secret }},auth-port=1812,acct-port=1813,req-limit=0

[cli]
tcp=127.0.0.1:2000
verbose=1

[log]
log-file=/var/log/accel-ppp/accel-ppp.log
log-emerg=/var/log/accel-ppp/emerg.log
copy=1
level=5
