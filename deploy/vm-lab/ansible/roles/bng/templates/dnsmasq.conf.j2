# Managed by Ansible (roles/bng) -- edit the template, not this file.
# eth1.1, not eth1 -- BNGBlaster's access-interface config always tags
# DHCP with an inner 802.1Q outer-vlan=1 (vlan-mode "N:1" shares this
# one vlan across every session, see simulation/bng_config.py's own
# docstring), independent of ESXi's own outer portgroup VLAN tagging.
interface=eth1.1
dhcp-range=10.20.0.10,10.20.0.200,12h
dhcp-option=option:router,10.20.0.1
# MAC blacklist -- telemetry/broadband_adapter.py's apply_mitigation()
# writes "<mac>,ignore" entries here and SIGHUPs this process to
# re-read it (see that module's own docstring for why session-stop
# alone isn't enough: BNGBlaster periodically re-DHCPs a session on its
# own, silently undoing a session-stop-only block).
dhcp-hostsfile=/tmp/bng_dhcp_blacklist.hosts
