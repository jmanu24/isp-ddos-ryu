@@ -29,6 +29,7 @@
 #include "srsran/ran/band_helper.h"
 #include "srsran/ran/pdsch/pdsch_constants.h"
 #include "srsran/scheduler/result/sched_result.h"
+#include "srsran/support/async/async_no_op_task.h"
 #include "srsran/support/async/async_timer.h"
 #include "srsran/support/async/execute_on_blocking.h"
 #include "srsran/support/executors/execute_until_success.h"
@@ -88,23 +89,19 @@ async_task<void> mac_cell_processor::start()
   // Note: This is done in the control executor context to avoid concurrency with other CTRL procedures.
   sched.handle_cell_activation(cell_cfg.cell_index);
 
-  return execute_and_continue_on_blocking(
-      cell_exec,
-      ctrl_exec,
-      timers,
-      [this]() noexcept SRSRAN_RTSAN_NONBLOCKING {
-        if (state != cell_state::inactive) {
-          // No-op.
-          return;
-        }
-
-        state = cell_state::active;
-        logger.info("cell={}: Cell was activated", fmt::underlying(cell_cfg.cell_index));
-      },
-      [this]() {
-        logger.warning("cell={}: Postponed cell start operation. Cause: Task queue is full",
-                       fmt::underlying(cell_cfg.cell_index));
-      });
+  // WORKAROUND (gitlab.com/ocudu/ocudu#571): cell_exec.execute()/defer() never
+  // gets dispatched in virtualized environments (ESXi here, VirtualBox in the
+  // upstream report), so execute_and_continue_on_blocking() suspends forever
+  // waiting for a resume that never arrives -- confirmed on a real run: DU
+  // connects F1-C to the CU fine, then the UE never even attempts a PRACH
+  // because the cell never actually activates. Run the task inline instead
+  // of hopping executors -- this is the same "MAC patch" the upstream issue
+  // describes as unblocking gNB startup.
+  if (state == cell_state::inactive) {
+    state = cell_state::active;
+    logger.info("cell={}: Cell was activated", fmt::underlying(cell_cfg.cell_index));
+  }
+  return launch_no_op_task();
 }
 
