# Managed by Ansible (roles/br). Distributed-VM equivalent of the flags
# webtool/peering_ops.py's Mininet path passes to `flow run` -- must stay
# in sync with that module's own FLOW_LOCAL_AS/EXABGP_LOCAL_AS constants
# (65001/65002) if either ever changes.
#
# --hooked is load-bearing, not decoration: without it, flow's nftables
# rule is created as a REGULAR (non-base) chain that nothing ever jumps
# to, so it's created but never evaluated by the kernel -- confirmed via
# this exact failure mode during the Mininet-mode spike (see webtool/
# peering_ops.py's own long comment on this flag). --hooked attaches
# directly to nftables' `input` hook, which is why 10.99.0.1/32 is added
# to br's own loopback (this role's "Add dummy central_server address"
# task) -- traffic to it is locally delivered, not forwarded, matching
# what --hooked actually hooks.
[Unit]
Description=flow -- BGP FlowSpec to nftables (Peering domain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/flow run -b {{ br_peering_addr }}:179 -l 65001 -r 65002 -i {{ br_peering_addr }} -a {{ orchestrator_addr }} --hooked
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
