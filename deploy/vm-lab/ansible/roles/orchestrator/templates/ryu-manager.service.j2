# Managed by Ansible (roles/orchestrator). Was a raw nohup-style process
# started by hand (stdout/stderr landing wherever /proc/<pid>/fd pointed --
# confirmed on a real run it was /tmp/ryu.log, not any well-known path) --
# converted to a proper unit for the same reason exabgp was: restartable,
# persistent, and its log lands somewhere predictable.
[Unit]
Description=ryu-manager -- centralized SDN controller (Enterprise/OpenFlow domain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Tesis_Controller
# Load-bearing: ryu's dynamic app loader imports ryu_controller_2.py by
# file path, not as a package, so its own `from forwarding.learning_switch
# import ...` (and telemetry/correlation/detection/orchestration/web/
# config/core) only resolves if /opt/Tesis_Controller itself is on
# sys.path. The interactive process this replaced only worked because
# whoever launched it had something (PYTHONPATH, a shell rc file) putting
# it there already -- confirmed on a real run: systemd's clean
# environment doesn't have that, and the service crash-looped with
# ModuleNotFoundError: No module named 'forwarding' without this.
Environment=PYTHONPATH=/opt/Tesis_Controller
# Load-bearing for BOTH the peering and broadband domains' real-VM
# pipelines -- config/settings.py's PEERING_DISTRIBUTED_MODE/
# BNG_DISTRIBUTED_MODE are plain os.environ.get() toggles, defaulting
# False (Mininet-mode code paths) unless this is set. CONFIRMED GAP on
# a real run: this Environment= line was missing entirely when this
# unit was first created (converting ryu-manager from a raw hand-
# launched process, which evidently had PEERING_DISTRIBUTED_MODE set
# some other way -- e.g. the launching shell's own environment -- that
# systemd's clean environment doesn't inherit), silently falling back
# to Mininet-mode peering logic under systemd until this was found.
Environment=PEERING_DISTRIBUTED_MODE=true
Environment=BNG_DISTRIBUTED_MODE=true
ExecStart=/opt/Tesis_Controller/venv/bin/ryu-manager --observe-links controller/ryu_controller_2.py
Restart=on-failure
RestartSec=2
StandardOutput=append:/var/log/ryu-manager.log
StandardError=append:/var/log/ryu-manager.log

[Install]
WantedBy=multi-user.target
