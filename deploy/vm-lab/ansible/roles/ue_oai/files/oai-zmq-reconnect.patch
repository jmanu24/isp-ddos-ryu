 void zmq_rx_channel::receive(c16_t *samples, size_t nsamps)
 {
   size_t samples_popped = 0;
+  auto start_time = std::chrono::steady_clock::now();
+  static constexpr std::chrono::milliseconds RX_STALL_TIMEOUT = std::chrono::milliseconds(5000);
   while (samples_popped < (size_t)nsamps && !stopped_) {
     size_t popped_now = buffer_.pop_samples(samples + samples_popped, nsamps - samples_popped);
     samples_popped += popped_now;
     if (popped_now == 0) {
+      // Give up and fill the rest with silence instead of blocking this call forever.
+      // zmq_rx_stream::receive() (this file, below) calls tx_stream_->align() right
+      // before this -- confirmed on a real run: that ties this UE's own TX sample-clock
+      // advancement to this RX call returning, so blocking here indefinitely also
+      // freezes this UE's own uplink production, which then starves the gNB's own RX
+      // too -- a mutual stall neither side's transport-level reconnect logic can break
+      // on its own.
+      if (std::chrono::steady_clock::now() - start_time > RX_STALL_TIMEOUT) {
+        memset(samples + samples_popped, 0, (nsamps - samples_popped) * sizeof(c16_t));
+        return;
+      }
       usleep(100); // wait for more samples to arrive
+    } else {
+      start_time = std::chrono::steady_clock::now();
     }
   }
 }
