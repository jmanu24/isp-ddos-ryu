+// Recreates and reconnects a stalled RX (ZMQ_REQ) channel, then sends a fresh priming
+// request so rx_poll_thread's cycle can resume. See zmq_rx_channel's own header comment
+// (zmq_imported.h) for why this is needed: a ZMQ_REQ socket cannot simply retry send()
+// after a failure once its paired REP peer (the gNB) has recreated its own socket, since
+// the two ends no longer agree on whose turn it is to speak.
+static bool reconnect_rx_channel(zmq_rx_channel *chan, size_t i)
+{
+  LOG_W(HW, "[ZMQ] Request/response cycle stalled. Reconnecting RX antenna %d (%s).\n", (int)i, chan->address_.c_str());
+
+  if (chan->socket_) {
+    zmq_close(chan->socket_);
+    chan->socket_ = nullptr;
+  }
+
+  void *socket = zmq_socket(chan->zmq_context_, ZMQ_REQ);
+  if (!socket) {
+    LOG_E(HW, "[ZMQ] Failed to recreate RX socket for antenna %d: %s\n", (int)i, zmq_strerror(errno));
+    return false;
+  }
+  int linger = 0;
+  zmq_setsockopt(socket, ZMQ_LINGER, &linger, sizeof(linger));
+  if (zmq_connect(socket, chan->address_.c_str()) != 0) {
+    LOG_E(HW, "[ZMQ] Failed to reconnect RX socket for antenna %d: %s\n", (int)i, zmq_strerror(errno));
+    zmq_close(socket);
+    return false;
+  }
+  chan->socket_ = socket;
+
+  char dummy = 0;
+  if (zmq_send(chan->socket_, &dummy, 1, 0) != 1) {
+    LOG_E(HW, "[ZMQ] Failed to send priming request after reconnect for antenna %d: %s\n", (int)i, zmq_strerror(errno));
+    return false;
+  }
+
+  LOG_I(HW, "[ZMQ] RX antenna %d reconnected (%s).\n", (int)i, chan->address_.c_str());
+  return true;
+}
