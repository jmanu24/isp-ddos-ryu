# Managed by Ansible (roles/ue_srsue) -- same single-UE, direct-to-gNB
# pattern as ue_direct_zmq.conf.j2 (see that file's own header for the
# full reasoning), but pointed at the DU's radio on the SEPARATE `du` VM
# instead of `ran` -- confirmed necessary on a real run: with the CU/DU
# split across two VMs (see ran_srsran/du_srsran roles), the RU/PHY
# lives on `du` now, not `ran` -- ue_direct_zmq.conf.j2's own rx_port
# (ran_ran_addr) pointed the UE at a VM with no radio on it at all,
# silently going nowhere (no RACH attempt, no error either -- ZMQ REQ/
# REP just never got a peer to complete its handshake with).

[rf]
freq_offset = 0
tx_gain = 50
rx_gain = 40
srate = 11.52e6
nof_antennas = 1

device_name = zmq
device_args = tx_port=tcp://0.0.0.0:2001,rx_port=tcp://{{ du_ran_addr | default('10.40.0.4') }}:2000,base_srate=11.52e6

[rat.eutra]
dl_earfcn = 2850
nof_carriers = 0

[rat.nr]
bands = 3
nof_carriers = 1
max_nof_prb = 52
nof_prb = 52

[pcap]
enable = none
mac_filename = /tmp/ue_direct_mac.pcap
mac_nr_filename = /tmp/ue_direct_mac_nr.pcap
nas_filename = /tmp/ue_direct_nas.pcap

[log]
all_level = info
phy_lib_level = none
all_hex_limit = 32
filename = /tmp/ue_direct.log
file_max_size = -1

[usim]
mode = soft
algo = milenage
opc  = 63bfa50ee6523365ff14c1f45f88737d
k    = 00112233445566778899aabbccddeeff
imsi = 001010123456780
imei = 353490069873319

[rrc]
release = 15
ue_category = 4

[nas]
apn = srsapn
apn_protocol = ipv4

[gw]
netns = ue1
ip_devname = tun_srsue
ip_netmask = 255.255.255.0

[gui]
enable = false
