-// 5.1.2 Random Access Resource selection (TODO)
+// 5.1.2 Random Access Resource selection
 void proc_ra_nr::ra_resource_selection()
 {
+  // Randomly select the preamble for this RA procedure -- confirmed on a real run: this used to
+  // be unconditionally preamble_index=0/prach_occasion=0 in ra_preamble_transmission() below (no
+  // selection at all, matching this function's own former "(TODO)" label). With multiple UEs
+  // sharing one gNB (e.g. this lab's multi-UE ZMQ broker, which combines several UEs into a
+  // single RF channel toward the gNB), every UE always picked the SAME preamble at the SAME
+  // occasion -- bit-identical PRACH transmissions, indistinguishable to the gNB's own PRACH
+  // detector no matter how the samples get combined upstream (confirmed: the gNB logged exactly
+  // ONE PRACH detection and ONE UE context for 3 simultaneously-attaching UEs). Seeded per-
+  // process (PID + time) so concurrent srsue instances reliably diverge. 64 matches this lab's
+  // own gNB cell_cfg.prach.total_nof_ra_preambles -- not read from rach_cfg_nr_t here because
+  // srsRAN_4G never threads that value down from RRC config into this struct in the first place
+  // (see rach_cfg_nr_t's own definition, srsran/interfaces/mac_interface_types.h -- no preamble
+  // -count field exists on it at all). prach_occasion selection among multiple configured
+  // occasions remains unimplemented (still effectively a TODO) -- out of scope for what this
+  // lab's single-occasion cell_cfg needs.
+  static bool seeded = false;
+  if (!seeded) {
+    std::srand(static_cast<unsigned>(std::time(nullptr)) ^ static_cast<unsigned>(getpid()));
+    seeded = true;
+  }
+  preamble_index = std::rand() % 64;
+  prach_occasion = 0;
   ra_preamble_transmission();
 }
 
