 #include <string.h>
 #include <zmq.h>
 
+// Recreates the socket and reconnects to the peer. ZeroMQ's REQ socket enforces strict
+// send/recv alternation -- once a request goes unanswered there is no API-level way to
+// resend on the same socket. Confirmed on a real run: the colocated gNB+UE ZMQ loopback
+// can permanently wedge this thread in zmq_recv() after a NAS signaling burst desyncs the
+// per-TTI request/reply cadence, with the peer's own socket having since been recreated
+// (see the gNB-side radio_zmq_rx_channel::reconnect() fix this mirrors) -- retrying recv()
+// on the old connection then waits forever for a reply that will never come, since the new
+// peer socket has no record of the stale request. This closes and reopens the socket so the
+// caller can fall back to the outer loop and send a fresh request.
+static void rf_zmq_rx_reconnect(rf_zmq_rx_t* q)
+{
+  rf_zmq_info(q->id, "Request/response cycle stalled. Reconnecting receiver socket.\n");
+
+  if (q->sock) {
+    zmq_close(q->sock);
+    q->sock = NULL;
+  }
+
+  q->sock = zmq_socket(q->zmq_ctx, q->socket_type);
+  if (!q->sock) {
+    fprintf(stderr, "[zmq] Error: recreating receiver socket: %s\n", zmq_strerror(zmq_errno()));
+    return;
+  }
+
+  if (zmq_connect(q->sock, q->sock_args)) {
+    fprintf(stderr, "[zmq] Error: reconnecting receiver socket: %s\n", zmq_strerror(zmq_errno()));
+    return;
+  }
+
+  if (q->trx_timeout_ms) {
+    int timeout = q->trx_timeout_ms;
+    if (zmq_setsockopt(q->sock, ZMQ_RCVTIMEO, &timeout, sizeof(timeout)) == -1) {
+      fprintf(stderr, "[zmq] Error: setting receive timeout on rx socket\n");
+      return;
+    }
+    if (zmq_setsockopt(q->sock, ZMQ_SNDTIMEO, &timeout, sizeof(timeout)) == -1) {
+      fprintf(stderr, "[zmq] Error: setting send timeout on rx socket\n");
+      return;
+    }
+    timeout = 0;
+    if (zmq_setsockopt(q->sock, ZMQ_LINGER, &timeout, sizeof(timeout)) == -1) {
+      fprintf(stderr, "[zmq] Error: setting linger timeout on rx socket\n");
+      return;
+    }
+  }
+
+  rf_zmq_info(q->id, "Receiver socket reconnected.\n");
+}
