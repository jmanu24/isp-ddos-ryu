# Managed by Ansible (roles/core5g_open5gs). Explicit netplan for the
# VLAN_BACKBONE interface -- hot-added via govc vm.network.add AFTER this
# VM was already provisioned, so cloud-init's own generated 99-lab.yaml
# never saw it (same gap bng's own 97-bb-access.yaml.j2 documents for
# the exact same reason). Confirmed by hand via `ip -br link show`
# that this landed on {{ core5g_backbone_iface }}, not a guessed name.
network:
  version: 2
  ethernets:
    {{ core5g_backbone_iface }}:
      addresses: [{{ own_backbone_addr }}/30]
