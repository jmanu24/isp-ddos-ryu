# Managed by Ansible (roles/core5g_open5gs) -- based on srsRAN's own
# official multi-UE application note open5gs.env, with ONE deliberate
# change from the original (which assumes gNB and core share one PC):
#
#   OPEN5GS_IP / UPF_ADVERTISE_IP changed from the tutorial's docker-
#   internal 10.53.1.2 to this lab's real, cross-VM-routable RAN address
#   ({{ core5g_ran_addr | default('10.40.0.1') }}) -- otherwise the gNB on
#   a DIFFERENT VM can never reach the AMF/UPF at all.
#
# THIS IS THE SINGLE RISKIEST INTEGRATION POINT in the whole RAN/Core/
# RIC/UE stack: making that address actually work for a container
# (not just the docker host) typically needs either `network_mode: host`
# or a macvlan network in srsRAN_Project/docker/docker-compose.yml, which
# this role does NOT modify for you (that compose file is srsRAN's own,
# re-generated on every `git pull`, so hand-patching it here would silently
# break on the next update). If the gNB can't reach the AMF, START by
# checking connectivity from the ran VM to core5g on tcp/udp 38412
# (N2/SCTP) -- don't chase anything else first.
MONGODB_IP=127.0.0.1
OPEN5GS_IP={{ core5g_ran_addr | default('10.40.0.1') }}
UE_IP_BASE=10.45.0
UPF_ADVERTISE_IP={{ core5g_ran_addr | default('10.40.0.1') }}
DEBUG=false
SUBSCRIBER_DB="subscriber_db.csv"
NETWORK_NAME_FULL=srsRAN
NETWORK_NAME_SHORT=srsRAN
TZ=UTC
