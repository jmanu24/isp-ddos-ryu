# Managed by Ansible (roles/peer_router) -- real eBGP with br.
router id 10.30.0.2;

protocol device {}

protocol static default_route {
    ipv4;
    # blackhole, not `via 10.30.0.1` -- confirmed on a real run: that
    # nexthop is br's OWN address, the exact eBGP neighbor we're
    # advertising this default route TO, which is circular (peer-router
    # is meant to model "the rest of the internet" upstream of br, not
    # point back at it). Symptom was silent: `show route export br`
    # correctly showed 0.0.0.0/0 in the computed export set, but the
    # actual UPDATE sent on the wire on every fresh session (protocol
    # restart AND full `systemctl restart bird`, ruling out a caching
    # fluke) was a bare withdraw + End-of-RIB, never a real announcement.
    route 0.0.0.0/0 blackhole;
}

protocol bgp br {
    local as {{ bgp_peer_router_as }};
    neighbor 10.30.0.1 as {{ bgp_br_as }};
    ipv4 {
        import none;
        export where source = RTS_STATIC;  # announce only the default route
    };
}
