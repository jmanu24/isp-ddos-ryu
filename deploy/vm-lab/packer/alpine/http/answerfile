# Alpine setup-alpine answerfile -- used ONLY for building the tpl-alpine
# golden image itself (DHCP, generic hostname). Per-VM static IP/hostname
# answerfiles for the actual 7 clones are generated by
# ../../scripts/render_topology.py from ../../topology.yaml -- do not add
# static addressing here.
KEYMAPOPTS="us us"
HOSTNAMEOPTS="tpl-alpine"
INTERFACESOPTS="auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
"
DNSOPTS="-d local 1.1.1.1"
TIMEZONEOPTS="-z UTC"
PROXYOPTS="none"
APKREPOSOPTS="-1"
SSHDOPTS="-c openssh"
NTPOPTS="-c chrony"
DISKOPTS="-m sys /dev/sda"
LBUOPTS="none"
APKCACHEOPTS="none"
