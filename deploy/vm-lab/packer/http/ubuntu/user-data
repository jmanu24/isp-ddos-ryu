#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard: {layout: us}
  network:
    version: 2
    ethernets:
      any-en:
        match: {name: "en*"}
        dhcp4: true
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout: {name: direct}
  identity:
    hostname: tpl-ubuntu-2204
    username: labadmin
    # SHA-512 crypt of "srslab-temp" -- verified (re-derived with the same
    # salt reproduces this exact hash: `openssl passwd -6 -salt
    # a138b4a7baaaffef srslab-temp`). MUST match packer/ubuntu-2204.pkr.hcl's
    # ssh_password var if you change the password -- regenerate with:
    #   openssl passwd -6 -salt "$(openssl rand -hex 8)" 'your-password-here'
    password: "$6$a138b4a7baaaffef$FL199Um6qdvW1l4n2upNs2B44BmQmF74DxIYY2CkoXSCBLLL/kWyC6h2pqIDmtiOcYZgz3p6//r1fF6o4P2NP1"
  packages:
    - qemu-guest-agent
    - cloud-init
    - python3
    - openssh-server
  late-commands:
    - "curtin in-target --target=/target -- systemctl enable ssh"
  user-data:
    disable_root: false
